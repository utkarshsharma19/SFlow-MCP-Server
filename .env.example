# ---------------------------------------------------------------------------
# FlowMind .env  — copy to .env and edit before ``docker compose up``.
# Every variable here has a working default in docker-compose.yml, so a
# blank .env is fine for first-boot dev; the values below are what you'd
# override on a real testbed.
# ---------------------------------------------------------------------------

# Core (telemetry API + MCP server reach each other inside the compose
# network; these vars are only relevant when running outside Docker).
DATABASE_URL=postgresql+asyncpg://flowmind:flowmind_dev@localhost/flowmind
REDIS_URL=redis://localhost:6379
SFLOW_RT_URL=http://localhost:8008
TELEMETRY_API_URL=http://localhost:8080

# Multi-tenant auth (PR 20+): API keys live in api_keys (sha256 hashed).
# Migration 0003 seeds tenant ``default`` + key ``dev-insecure-key``.
# To issue a real testbed key:
#   docker compose exec telemetry-api python -m scripts.seed create-tenant \
#       --slug acme --name "Acme"
#   docker compose exec telemetry-api python -m scripts.seed create-key  \
#       --tenant-slug acme --role operator --name alice
TELEMETRY_API_KEY=dev-insecure-key

# pgcrypto data key (PR 27). REQUIRED for the webhook dispatcher and any
# encrypted_secrets read/write. Without this set the webhook loop logs a
# warning and idles — features that don't need it (sFlow ingest, MCP
# tools, metrics) still work. Generate with: ``openssl rand -base64 32``.
FLOWMIND_DATA_KEY=dev-data-key-rotate-in-prod
FLOWMIND_DATA_KEY_VERSION=1

# gNMI / OpenConfig collector (PR 21).
# Comma-separated host[:port] list. Default port is 6030 (Arista); SONiC
# typically uses 8080 over TLS. Empty → loop idles cleanly.
#   GNMI_TARGETS=spine1:6030,leaf1:6030,leaf2:6030
GNMI_TARGETS=
GNMI_USERNAME=admin
GNMI_PASSWORD=
GNMI_POLL_INTERVAL_SECONDS=60

# Per-source → tenant routing cache TTL (PR 22). Operators add mappings
# via the seed CLI; the cache refresh tick is this many seconds.
#   docker compose exec telemetry-api python -m scripts.seed map-source \
#       --kind sflow --identifier 10.0.1.5 --tenant-slug acme
TENANT_ROUTING_TTL_SECONDS=60

# Webhook dispatcher tuning (PR 30). Dispatcher polls every INTERVAL
# seconds, times out after TIMEOUT seconds per POST, and suspends a
# subscription after MAX_FAILURES consecutive failures.
WEBHOOK_DISPATCH_INTERVAL=20
WEBHOOK_DISPATCH_TIMEOUT=5
WEBHOOK_MAX_FAILURES=10

# Verity intent collector (PR 30). Loop idles when BASE_URL or TOKEN is
# empty — fine for non-Verity testbeds. Tenant routing for verity
# follows the same pattern as sflow/gnmi:
#   docker compose exec telemetry-api python -m scripts.seed map-source \
#       --kind verity --identifier default --tenant-slug acme
VERITY_BASE_URL=
VERITY_TOKEN=
VERITY_POLL_INTERVAL_SECONDS=300
VERITY_CONTROLLER_ID=default

# MCP-server circuit breaker (PR 30). Trips after N consecutive 5xx /
# transport failures and short-circuits new calls for COOLDOWN seconds.
# 4xx errors do NOT count toward the budget (caller bugs are not faults).
MCP_CB_FAILURE_THRESHOLD=5
MCP_CB_COOLDOWN_SECONDS=30

LOG_LEVEL=INFO
